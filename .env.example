# Backend Configuration
DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# Database
DATABASE_URL=sqlite:///./test.db
# DATABASE_URL=postgresql://user:password@localhost/fx_volume

# API Keys - احصل عليها من المواقع المختصة
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
OANDA_API_KEY=your_oanda_api_key
OANDA_ACCOUNT_ID=your_oanda_account_id

# Email Configuration (للتنبيهات)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@fxvolume.com

# Redis (اختياري)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ML Models Path
ML_MODELS_PATH=./app/ml/models

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Trading Parameters
MIN_CONFIDENCE_THRESHOLD=0.65
MAX_POSITIONS=5
DEFAULT_RISK_RATIO=1:2

# Frontend
REACT_APP_API_URL=http://localhost:8000/api/v1